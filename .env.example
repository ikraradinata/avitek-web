# Salin menjadi .env.local dan isi nilainya. Untuk Vercel: Settings > Environment Variables.
GOOGLE_SCRIPT_URL=              # URL Web App dari Apps Script, server saja
GOOGLE_SCRIPT_SECRET=           # sama dengan AVITEK_SECRET di Script Properties, server saja
IP_HASH_SALT=                   # teks acak panjang, server saja
NEXT_PUBLIC_SITE_URL=https://
NEXT_PUBLIC_SHOW_PROPOSED=false # berlaku untuk ID dan EN sekaligus
